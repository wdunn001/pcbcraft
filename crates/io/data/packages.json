[
  {
    "id": "fab_prototype",
    "name": "Prototype fab (Gerber + drill)",
    "audience": "Online prototype board makers that take a ZIP of Gerber layers with Protel-style extensions and drill files, no folders.",
    "container": "zip",
    "archive": "{project}-fab-{rev}.zip",
    "files": [
      {
        "kind": "gerbers",
        "format": "gerber_layers",
        "name": "{project}.{ext}",
        "options": {
          "naming": "protel"
        }
      },
      {
        "kind": "gerbers",
        "format": "gerber_drill",
        "name": "{project}-{layer}.{ext}",
        "options": {
          "naming": "protel"
        }
      },
      {
        "kind": "gerbers",
        "format": "drill_map",
        "name": "{project}-{layer}.{ext}"
      },
      {
        "kind": "report",
        "format": "fab_readme",
        "name": "{project}-{layer}.{ext}"
      }
    ]
  },
  {
