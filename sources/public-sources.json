{
  "schema_version": 1,
  "sources": [
    {
      "kind": "static-url",
      "id": "pcbcraft-fixture",
      "name": "PCBCraft fixture static registry",
      "url": "https://example.com/pcbcraft/fixture-registry/"
    },
    {
      "kind": "git",
      "id": "community-registry",
      "name": "Community registry git tree",
      "repo": "https://github.com/example/pcbcraft-registry.git"
    },
    {
      "kind": "pack",
      "id": "offline-pack",
      "name": "Offline registry pack file",
      "path": "packs/community.pack"
    },
    {
      "kind": "instance",
      "id": "peer-instance",
      "name": "Peer PCBCraft instance feed",
      "feed": "instances.json"
    }
  ]
}
