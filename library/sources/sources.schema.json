{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCBCraft source index",
  "type": "object",
  "required": ["schema", "updated", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pcbcraft-sources/1" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string", "maxLength": 500 },
    "sources": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "url", "licence", "maintainer", "trust"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "enum": ["builtin", "static-url", "git", "pack", "distributor-connector", "local"] },
          "url": { "type": "string", "maxLength": 500 },
          "mirrors": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 500 } },
          "licence": { "type": "string", "minLength": 1, "maxLength": 200 },
          "maintainer": { "type": "string", "minLength": 1, "maxLength": 120 },
          "public_key": { "type": "string", "maxLength": 200 },
          "categories": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 40 } },
          "trust": { "enum": ["builtin", "reviewed", "unreviewed"] },
          "description": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
