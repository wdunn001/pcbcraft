# Copy to site/.env.deploy (gitignored) and fill in. Every value is required
# unless marked optional. Nothing here is read from the repo itself.
DEPLOY_SSH_TARGET=user@host.example
# Directory on the target that holds releases/ and the current symlink.
DEPLOY_REMOTE_ROOT=/path/on/target/site
# Built site to ship, relative to site/ (default: dist).
DEPLOY_DIST=dist
# Public URL used for the post-deploy check (optional).
DEPLOY_CHECK_URL=https://example.invalid
# Container to health-check after the swap (optional; empty to skip).
DEPLOY_CONTAINER=example-container
# How many releases to keep for rollback (optional, default 5).
DEPLOY_KEEP=5
# Extra ssh options (optional), for example a jump host or key.
DEPLOY_SSH_OPTS=
